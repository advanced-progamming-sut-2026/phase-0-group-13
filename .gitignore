src/data/database/session.json

# The server's own account database: password hashes, emails and per-player game state, written
# at runtime by whoever runs the server. Not something to carry in the repo, and a committed copy
# would fight with every other machine's.
src/data/database/server-accounts.json

# The extracted asset library (resources/raw) is tracked on purpose so a clone gets the
# complete collection. The source archive stays out: it is 362 MB, over GitHub's 100 MB
# file limit, and resources/raw is a byte-exact copy of what is inside it.
# See docs/phase2/asset-organization.md.
resources/_source/pvz-assets.zip
tools/pvz-libs/*.zip

# Gradle's own build output and local cache, plus IntelliJ's mirror of the same compiled classes.
# All of it is regenerated by the build, none of it should ever have been committed: every local
# build or test run dirtied git status with it, and a 1.9GB .git history built from repeatedly
# committing this (resources/, build/, .gradle/) is the root cause of HamGit's push/fetch timeouts.
build/
.gradle/
out/
